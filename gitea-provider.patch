+async function giteaRequest(token, apiBase, method, path, body) {
+  const init = {
+    method,
+    headers: { Authorization: 'token ' + token, Accept: 'application/json', 'Content-Type': 'application/json' },
+  }
+  if (body !== undefined) init.body = JSON.stringify(body)
+  const r = await fetch(apiBase + path, init)
+  const text = await r.text()
+  let json = null
+  try { json = text === '' ? null : JSON.parse(text) } catch {}
+  return { ok: r.ok, status: r.status, json, text }
+}
+
+/** Resolve the REST target that owns this remote, or null when the host has
+ *  no pull-request API we can drive (SSH-only remotes, plain git servers). */
+async function repoApiTarget(eff) {
+  const repoUrl = (eff && eff.repoUrl) || ''
+  const token = (eff && eff.token) || ''
+  const provider = detectRepoProvider(repoUrl)
+  if (!provider.owner || !provider.repo || !token) return null
+  if (provider.kind === 'gitcode') {
+    return {
+      kind: 'gitcode', provider, owner: provider.owner, repo: provider.repo,
+      req: (method, path, body) => gitcodeRequest(token, method, path, body),
+    }
+  }
+  if (provider.kind !== 'generic') return null
+  const apiBase = await probeGiteaApi(repoUrl)
+  if (!apiBase) return null
+  return {
+    kind: 'gitea', provider, owner: provider.owner, repo: provider.repo, apiBase,
+    req: (method, path, body) => giteaRequest(token, apiBase, method, path, body),
+  }
 }
 
+async function createPullRequest(target, { head, base, title, body }) {
+  return target.req('POST', `/repos/${target.owner}/${target.repo}/pulls`, { head, base, title: title || 'dsh-sync', body: body || '' })
+}
+
+async function getPullRequest(target, number) {
+  return target.req('GET', `/repos/${target.owner}/${target.repo}/pulls/${number}`)
+}
+
+async function mergePullRequest(target, number, method) {
+  if (target.kind === 'gitea') {
+    // Gitea/Forgejo spell the strategy as `Do`; default to a plain merge.
+    return target.req('POST', `/repos/${target.owner}/${target.repo}/pulls/${number}/merge`, {
+      Do: method || 'merge',
+      delete_branch_after_merge: false,
+    })
+  }
+  return target.req('PUT', `/repos/${target.owner}/${target.repo}/pulls/${number}/merge`, method ? { merge_method: method } : {})
+}
