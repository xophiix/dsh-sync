+/** Probe `<origin>/api/v1/version`. Gitea/Forgejo answer `{"version":…}`;
+ *  GitLab and plain git hosts 404 there, so the probe doubles as detection.
+ *  Cached per origin: the sync loop asks on every push. */
+async function probeGiteaApi(repoUrl) {
+  const origin = repoOrigin(repoUrl)
+  if (!origin) return null
+  // 命中即用；失败结果只记 60s——偶发网络抖动不该让 PR 永久降级
+  const hit = giteaApiCache.get(origin)
+  if (hit && (hit.apiBase || Date.now() - hit.at < GITEA_PROBE_RETRY_MS)) return hit.apiBase
+  let apiBase = null
+  try {
+    const init = { headers: { Accept: 'application/json' } }
+    if (typeof AbortSignal !== 'undefined' && typeof AbortSignal.timeout === 'function') init.signal = AbortSignal.timeout(5000)
+    const r = await fetch(origin + '/api/v1/version', init)
+    const json = r.ok ? await jsonOrNull(r) : null
+    if (json && json.version) apiBase = origin + '/api/v1'
+  } catch { /* unreachable / not a Gitea — treat as "no PR API" */ }
+  giteaApiCache.set(origin, { apiBase, at: Date.now() })
+  return apiBase
 }
 
