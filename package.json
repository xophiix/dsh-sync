{
  "name": "@weibaohui/dsh-sync",
  "version": "0.4.12-gitea.1",
  "description": "dsh 插件 · 多机同步与多协议备份（Git 分支→PR→合并 / WebDAV / 本地文件夹）。本仓库是 @weibaohui/dsh-sync 的 fork：新增自建 Gitea/Forgejo 的 PR 创建与自动合并。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sync",
    "backup",
    "webdav",
    "git",
    "gitcode",
    "dsh-plugin",
    "gitea",
    "forgejo"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test --experimental-test-isolation=none --test-timeout=120000 --test-force-exit test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xophiix/dsh-sync.git"
  },
  "homepage": "https://github.com/xophiix/dsh-sync#readme",
  "bugs": {
    "url": "https://github.com/xophiix/dsh-sync/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "weibaohui (upstream) / xophiix (fork)"
}